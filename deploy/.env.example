# Sentinel Gujarat - environment for deploy/docker-compose.yml (CONTRACT §1.3)
#
#   cp deploy/.env.example deploy/.env      (deploy.sh does this when .env is missing)
#
# The values below are the LAPTOP defaults: they work unchanged on any machine
# with Docker (COMPOSE_PROFILES=cpu, plain HTTP on :80, built-in mock catalogue).
# Lines marked (secret) are the repository defaults; deploy.sh warns while they
# are unchanged and REFUSES a public deployment with them. Never commit deploy/.env.
#
# -----------------------------------------------------------------------------
# A. LAPTOP (this file as-is)              docker compose ... up -d --build
# -----------------------------------------------------------------------------
#   COMPOSE_PROFILES=cpu                   MEDIAMTX_TRANSCODE=cpu
#   PUBLIC_BASE_URL=http://localhost       COOKIE_SECURE=0
#   CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
#   CADDY_SITE_ADDRESS=:80                 CADDY_EMAIL=
#   MTX_WEBRTCADDITIONALHOSTS=127.0.0.1    MTX_BIND=127.0.0.1
#   MOCK_SANDBOX=1                         SANDBOX_BASE_URL=http://api:8000/mock-sandbox
#   POSTGRES_PASSWORD / JWT_SECRET / *_API_KEY / JURY_*_PASSWORD = documented defaults
#   (the API only logs a warning about them on plain HTTP)
#
# -----------------------------------------------------------------------------
# B. HOSTED VM (written by deploy.sh --domain <fqdn> --gpu --sandbox-url <url>)
# -----------------------------------------------------------------------------
#   COMPOSE_PROFILES=gpu                   MEDIAMTX_TRANSCODE=nvenc
#   ANPR_MAX_CAMERAS=12                    PREINDEX_MAX_CAMERAS=50
#   PUBLIC_BASE_URL=https://<fqdn>         COOKIE_SECURE=1
#   CORS_ORIGINS=https://<fqdn>
#   CADDY_SITE_ADDRESS=<fqdn>              CADDY_EMAIL=<acme e-mail>
#   MTX_WEBRTCADDITIONALHOSTS=<public IP>  MTX_BIND=127.0.0.1 (never 0.0.0.0 on the VM)
#   MOCK_SANDBOX=0                         SANDBOX_BASE_URL=http://<organiser host>
#   SANDBOX_AUTH_TYPE / SANDBOX_USERNAME / SANDBOX_PASSWORD / SANDBOX_AUTH_HEADER from the Resources page
#   POSTGRES_PASSWORD=<openssl rand -hex 16>      generated by deploy.sh on a fresh .env
#   JWT_SECRET=<openssl rand -hex 32>             generated by deploy.sh on a fresh .env
#   INTERNAL_API_KEY=sk_<openssl rand -hex 20>    generated by deploy.sh on a fresh .env
#   BULK_API_KEY=sk_<openssl rand -hex 20>        generated by deploy.sh on a fresh .env
#   JURY_*_PASSWORD / DEPT_ADMIN_PASSWORD         choose your own; enter them in the portal form
#   With COOKIE_SECURE=1 or an https PUBLIC_BASE_URL the API exits at start-up
#   while POSTGRES_PASSWORD or JWT_SECRET still equal the defaults below.
#
# =============================================================================
# Compose / PostgreSQL
# =============================================================================
# cpu | gpu  (exactly one ANPR pair runs)
COMPOSE_PROFILES=cpu
POSTGRES_USER=sentinel
# (secret) URL-safe characters only [A-Za-z0-9_.-]: compose interpolates the value
# verbatim into DATABASE_URL (@ # ? % / break the URL, $ breaks compose).
# Recommended: openssl rand -hex 16. The postgres image applies it only when the
# data volume is created; to change it on a running stack use
# ./deploy/rotate-db-password.sh --generate (ALTER USER + this file + api restart).
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
# Leave empty to let compose build it from the three values above.
DATABASE_URL=

# Host interface for the MediaMTX RTSP/WHEP/HLS ports 8554/8888/8889.
# 127.0.0.1 = only this machine (safe default). 0.0.0.0 = whole LAN (phone tests
# on a laptop only; never on the VM). The unauthenticated control API (9997) and
# playback server (9996) always stay on 127.0.0.1.
MTX_BIND=127.0.0.1

# Resource caps (docker compose deploy.resources.limits). Defaults suit a
# 12-core laptop with ~8 GB given to Docker Desktop; raise on the VM.
POSTGRES_CPUS=2
POSTGRES_MEMORY=1g
MEDIAMTX_CPUS=4
MEDIAMTX_MEMORY=2g
API_CPUS=2
API_MEMORY=1536m
WEB_CPUS=1
WEB_MEMORY=256m
ANPR_LIVE_CPUS=6
ANPR_LIVE_MEMORY=3g
ANPR_PREINDEX_CPUS=3
ANPR_PREINDEX_MEMORY=2g

# =============================================================================
# API (service "api")
# =============================================================================
APP_VERSION=1.0.0-phase1
# (secret) >= 32 chars, e.g. openssl rand -hex 32
JWT_SECRET=change-me-sentinel-gujarat-2026-please
JWT_EXPIRE_HOURS=8
# https://<domain> on the VM
PUBLIC_BASE_URL=http://localhost
# https://<domain> only on the VM
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
# 1 on HTTPS
COOKIE_SECURE=0
DATA_DIR=/data
MEDIA_DIR=/media
RECORDINGS_DIR=/recordings
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
MEDIAMTX_RTSP_LOCAL_URL=rtsp://localhost:8554
MEDIAMTX_HLS_URL=http://mediamtx:8888
MEDIAMTX_PLAYBACK_URL=http://mediamtx:9996
# cpu (libx264) | nvenc (GPU VM, with docker-compose.gpu.yml)
MEDIAMTX_TRANSCODE=cpu

# Catalogue source. MOCK_SANDBOX=1 serves the 50-camera mock at
# /api/mock-sandbox/api/ingest (plus an unauthenticated webhook sink) and shows
# the MOCK SANDBOX badge - laptop only. For the organiser sandbox set
# MOCK_SANDBOX=0, SANDBOX_BASE_URL=http://<host> (the importer calls
# {base_url}/api/ingest) and the credentials from the Resources page
# (deploy.sh --sandbox-url/--sandbox-auth/... writes them; --domain without
# --mock forces MOCK_SANDBOX=0). All of these are editable at run time in
# Settings -> Catalogue; the env values are only the initial seed.
MOCK_SANDBOX=1
SANDBOX_BASE_URL=http://api:8000/mock-sandbox
# none | basic | bearer | header
SANDBOX_AUTH_TYPE=none
SANDBOX_USERNAME=
# (secret) basic password or bearer token
SANDBOX_PASSWORD=
# "Name: value" when SANDBOX_AUTH_TYPE=header
SANDBOX_AUTH_HEADER=
SANDBOX_TIMEOUT_S=30

# --- Organiser "Sentinel" sandbox (the real one: portal https://cctv.corp8.cloud, MediaMTX on
# 103.250.160.189, 30 cameras). Initial values of the catalogue.* / sandbox.* run-time settings
# (Settings -> Catalogue); the settings table wins once it exists, so edit them there afterwards.
# Catalogue adapter: mock | sentinel_portal | generic_json. Empty = mock while MOCK_SANDBOX=1,
# else generic_json. sentinel_portal hides the MOCK SANDBOX badge and the About page names the
# real source; the mock endpoint itself still follows MOCK_SANDBOX.
CATALOGUE_SOURCE=
# Stream relay: rtsp://<email>:<access password>@<host>:8554/stream/<id> (RTSP over TCP), WHEP on 8889,
# reference HLS https://cctv.corp8.cloud/<id>/index.m3u8 (needs a portal session; stored for reference only).
SANDBOX_STREAM_HOST=103.250.160.189
SANDBOX_RTSP_PORT=8554
SANDBOX_WHEP_PORT=8889
SANDBOX_HLS_BASE=https://cctv.corp8.cloud
# Registered e-mail (the "@" is percent-encoded in the URL by the API) and the separate ACCESS PASSWORD
# from the portal's Resources page (secret; never logged, masked in every response and audit row)
SANDBOX_STREAM_EMAIL=
SANDBOX_STREAM_PASSWORD=
# Optional portal login (cookie session) so the importer can GET /cameras.json itself. Leave the password
# empty to upload cameras.json on the Import page instead (the saved copy is media/cameras.json).
SANDBOX_PORTAL_URL=https://cctv.corp8.cloud
SANDBOX_PORTAL_EMAIL=
SANDBOX_PORTAL_PASSWORD=
# Team-inferred coordinates/department per camera (media/cameras_enrichment.csv, mounted at /app/media)
# and the server-side copy of the organiser catalogue; both can also be uploaded in the UI.
CATALOGUE_ENRICHMENT_PATH=/app/media/cameras_enrichment.csv
CATALOGUE_CAMERAS_JSON_PATH=/app/media/cameras.json
# ffprobe cap per sandbox camera, used by the importer (codec/resolution/fps/live) AND by the health poller,
# which probes external sources directly with this cap (the sandbox answers a DESCRIBE in 4-38 s; 12 s missed
# a third of the cameras). The relay's on-demand start timeout for these sources is this value + 10 s.
# Parallelism max 6 - "pace your load". Both are run-time settings (sandbox.probe_timeout_s / probe_parallel).
SANDBOX_PROBE_TIMEOUT_S=30
SANDBOX_PROBE_PARALLEL=6

# API keys, format sk_ + 40 lowercase alphanumerics (seeded on start)
# (secret) ANPR worker -> API
INTERNAL_API_KEY=sk_internal0000000000000000000000000000000000
# (secret) POST /api/v1/cameras/bulk
BULK_API_KEY=sk_bulk00000000000000000000000000000000000000

# Seed users (CONTRACT §2.7). Change all four before the hosted demo.
# (secret) jury_admin (admin)
JURY_ADMIN_PASSWORD=Sentinel@Admin2026
# (secret) jury_operator (operator)
JURY_OPERATOR_PASSWORD=Sentinel@Ops2026
# (secret) jury_viewer (viewer)
JURY_VIEWER_PASSWORD=Sentinel@View2026
# (secret) dept_admin_police (dept_admin, POLICE)
DEPT_ADMIN_PASSWORD=Sentinel@Police2026
SEED_ON_START=1

# Health poller
HEALTH_POLL_SECONDS=60
HEALTH_OFFLINE_AFTER=3
HEALTH_PROBE_MAX=2
# Cap for probing a LOCAL source through the relay (idle sandbox cameras use SANDBOX_PROBE_TIMEOUT_S)
HEALTH_PROBE_TIMEOUT_S=6
# "Pace your load" (relay policy, CONTRACT Amendments 2026-09-05): anpr_enabled + own-gate relay sources are persistent and
# never probed; idle on-demand cameras are probed at most HEALTH_PROBE_PARALLEL at a time, 3 s apart, HEALTH_PROBE_MAX per
# tick and at most once per HEALTH_PROBE_MIN_INTERVAL_S (status kept in between). HEALTH_PROBE_VIA=direct probes the source
# with one short connection; =relay probes through cam_<id> (which then holds the upstream copy for the 10-minute close-after).
HEALTH_PROBE_PARALLEL=2
HEALTH_PROBE_MIN_INTERVAL_S=900
HEALTH_PROBE_VIA=direct
ANPR_AUTO_ENABLE_MAX=12

# Alerts and routes (initial values of the run-time settings)
ALERT_SUPPRESSION_SECONDS=60
# Minutes after which an open (new/acknowledged) alert for the same plate+camera stops absorbing reads and a fresh alert is raised (0 = never)
ALERT_RE_ALERT_MINUTES=60
FUZZY_ALERT_MIN_CONF=0.8
ALERT_ESCALATE_MINUTES=5
ROUTE_SPEED_FLAG_KMH=150
ROUTE_DEFAULT_WINDOW_HOURS=24

# Gap analysis
GAP_COVERAGE_RADIUS_M=150
GAP_POI_RADIUS_M=300
GAP_GRID_M=500
AGEING_YEARS=5
GAP_CACHE_SECONDS=300

# Retention / privacy
RETENTION_DAYS_FRAMES=7
RETENTION_DAYS_READS=30
RETENTION_DAYS_CLIPS=90
# 21:00 UTC = 02:30 IST (deploy/backup.sh --install-cron schedules the pg_dump one hour later)
RETENTION_JOB_HOUR_UTC=21

# Misc
SNAPSHOT_STALE_SECONDS=10
WS_STATS_INTERVAL_S=10
# (secret) empty = disabled (P2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOGIN_RATE_LIMIT_PER_MIN=10
LOG_LEVEL=INFO
# never change: UI/exports render IST
TZ_DISPLAY=Asia/Kolkata

# =============================================================================
# ANPR workers (services anpr-live / anpr-preindex, or the -gpu twins)
# CPU, ANPR_MODE and the worker id are fixed per service in the compose file.
# =============================================================================
# comma list of camera ids to restrict a worker to (Phase 2 split)
ANPR_CAMERAS=
# live decoders on CPU (set 8 on a >= 8-core laptop; 12 on the GPU VM).
# Cameras that are anpr_enabled but beyond this cap get NO ANPR at all (the pre-index worker
# skips them as "covered live"), so the cap must cover every live camera you care about.
# Synthetic demo profile validated 5 Sept 2026 on a 12-core i5-1345U (all eight synthetic cameras
# at 5 fps, ~2.7 cores, 2.6 GB): ANPR_MAX_CAMERAS=8, ANPR_DETECTOR=contour, OBJECT_DETECT=0.
# Real organiser feeds on the same laptop (docs/anpr-camera-selection.md section 6, docs/sandbox-progress.md):
#   ANPR_MAX_CAMERAS=8 PREINDEX_MAX_CAMERAS=2 ANPR_FPS=2 PREINDEX_FPS=0.5 FRAME_WIDTH=1280
#   ANPR_DETECTOR=onnx ANPR_DET_TILE=768 ANPR_MIN_PLATE_W=28 OBJECT_DETECT=0 ANPR_LIVE_MEMORY=4g
# GPU VM (T4, COMPOSE_PROFILES=gpu):
#   ANPR_MAX_CAMERAS=12 PREINDEX_MAX_CAMERAS=50 ANPR_FPS=5 PREINDEX_FPS=1 FRAME_WIDTH=1920
#   ANPR_DETECTOR=onnx ANPR_DET_TILE=768 ANPR_MIN_PLATE_W=40 OBJECT_DETECT=1
ANPR_MAX_CAMERAS=3
# pre-index decoders on CPU (50 on the GPU VM)
PREINDEX_MAX_CAMERAS=3
ANPR_FPS=5
# key frames per second the pre-index worker keeps at most (key frames arrive every 1-2 s; 0.5 halves the load)
PREINDEX_FPS=1
PREINDEX_SKIP_LIVE=1
# decode width: 960 for the synthetic loops; on the organiser 1080p feeds 0 (= source resolution, native OCR crops) with
# ANPR_DETECT_WIDTH=1280 (laptop; the tiled detector runs on a 1280 px copy) or 1920 (GPU)
FRAME_WIDTH=960
# detector input width when FRAME_WIDTH is larger or 0 (0 = the decoded width)
ANPR_DETECT_WIDTH=0
# OCR backend (anpr/ocr.py): paddle (PaddleOCR on the enhanced crop) | fast_plate (fast-plate-ocr, MIT, ~5 ms) |
# ensemble (both; agreement wins). Measured on the organiser crop bank: docs/anpr-accuracy.md
ANPR_OCR=paddle
# fast-plate-ocr model in /app/weights: global_mobile_vit_v2_ocr | cct_s_v2_global | cct_xs_v2_global
ANPR_OCR_FAST_MODEL=global_mobile_vit_v2_ocr
# PaddleOCR: det = det+rec on every crop (the tight text-line box is what reads the organiser plates) | auto (rec-only on single-line crops) | rec
ANPR_OCR_PADDLE_MODE=det
ANPR_OCR_ENSEMBLE_MIN_CONF=0.45
# OCR only crops at least this wide (decoded px); narrower plate boxes are still tracked as detected vehicles
ANPR_OCR_MIN_W=60
# best-shot tracking (anpr/tracks.py): OCR the largest/sharpest crops of a plate track once it settles or ends,
# then vote; 0 = OCR every frame (pre-5-Sept behaviour, synthetic eval)
ANPR_BEST_SHOT=1
ANPR_TRACK_GAP_S=2
ANPR_TRACK_KEEP=3
ANPR_TRACK_STALL=3
# detected-vehicle evidence: one crop + JSON line per plate track under this directory (anpr-live bind-mounts
# ./media/anpr_evidence there; empty = off), capped per camera per hour
ANPR_EVIDENCE_DIR=/app/media/anpr_evidence
ANPR_EVIDENCE_PER_HOUR=200
# auto | onnx | contour
ANPR_DETECTOR=auto
ANPR_DET_MODEL=/app/weights/yolo-v9-t-384-license-plates-end2end.onnx
ANPR_DET_CONF=0.4
ANPR_MIN_PLATE_W=60
# tiled detection (0 = whole frame only): 768 px tiles + whole frame for 30-110 px plates in 1080p frames
ANPR_DET_TILE=0
ANPR_DET_TILE_OVERLAP=0.15
# overlay hygiene: boxes present in 80 % of the last N frames are muted (0 = off); boxes centred in the
# top/bottom band are never plates (0 = off); static-text regions learnt over the warm-up (0 = off);
# invalid-format reads per camera per minute at most (0 = unlimited; valid plates are never capped)
ANPR_STATIC_BOX_WINDOW=20
# share of the window a box must be present in to count as static (0.8; 0.5 on feeds whose captions are boxed intermittently)
ANPR_STATIC_BOX_HITS=0.8
ANPR_OSD_BAND=0.08
ANPR_OSD_WARMUP_S=30
ANPR_INVALID_READS_PER_MIN=10
# OCR budget per frame and CPU threads for PaddleOCR / onnxruntime
ANPR_MAX_BOXES=4
OCR_THREADS=2
ANPR_VOTE_WINDOW_S=3
ANPR_MIN_READ_CONF=0.30
SIGHTING_CLOSE_S=15
SNAPSHOT_INTERVAL_S=1
SNAPSHOT_WIDTH=480
POST_BATCH_S=1
CONFIG_RELOAD_S=60
HEARTBEAT_S=15
# YOLOX-s costs ~0.4 s per call on this CPU and finds no COCO objects in the synthetic drawings,
# so set 0 for the laptop demo; keep 1 on real footage (vehicle/person counts, intrusion zones).
OBJECT_DETECT=1
OBJECT_MODEL=/app/weights/yolox_s.onnx
OBJECT_CONF=0.35
OBJECT_EVERY_N=5
OCR_LANG=en
RECONNECT_MIN_S=2
RECONNECT_MAX_S=30
# decoder robustness on relay / organiser feeds (anpr/decode.py): RTSP sources are not ffprobe'd
# before the dial (stream info comes from ffmpeg's stderr; ANPR_RTSP_PROBE=1 restores the probe with
# ANPR_PROBE_TIMEOUT_S), 30 s RTSP socket timeout, 90 s budget for the first frame, 60 s stall
# watchdog, one decoder dials at a time with ANPR_DIAL_SPACING_S between dials, ffmpeg -threads per
# decoder, HTTP timeout towards the API (5xx/network errors are retried with 2->30 s backoff)
ANPR_PROBE_TIMEOUT_S=45
ANPR_RTSP_PROBE=0
ANPR_RTSP_TIMEOUT_S=30
ANPR_START_TIMEOUT_S=90
ANPR_STALL_TIMEOUT_S=60
ANPR_DIAL_SPACING_S=3
ANPR_DECODE_THREADS=2
API_TIMEOUT_S=30

# =============================================================================
# MediaMTX (service "mediamtx"): MTX_* variables override deploy/mediamtx.yml
# =============================================================================
# PUBLIC IP of the VM (comma list allowed); 127.0.0.1 on the laptop. deploy.sh
# detects it (api.ipify.org) or takes --public-ip; with 127.0.0.1 left on a VM
# WebRTC never connects from other machines and every tile falls back to HLS.
MTX_WEBRTCADDITIONALHOSTS=127.0.0.1
MTX_LOGLEVEL=info

# =============================================================================
# Web (service "web": Caddy)
# =============================================================================
# ":80" locally; "sentinel.example.in" on the VM -> automatic HTTPS
CADDY_SITE_ADDRESS=:80
# ACME contact e-mail (recommended when a domain is set)
CADDY_EMAIL=

# =============================================================================
# Synthetic generator (profile "tools", service "synth")
# =============================================================================
SYNTH_CAMERAS=8
SYNTH_SECONDS=90
SYNTH_SEED=42
SYNTH_OUT=/media/synthetic
